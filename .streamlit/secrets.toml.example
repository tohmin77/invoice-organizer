# Provide one or both extraction keys; the sidebar lets you switch between them
ANTHROPIC_API_KEY = "sk-ant-..."
DEEPSEEK_API_KEY = "sk-..."
# default_engine = "Claude"   # or "DeepSeek"
app_password = "choose-a-password"
sheet_url = "https://docs.google.com/spreadsheets/d/<your-sheet-id>/edit"
# Optional: folder in a Shared Drive (add the service account as a member) to store renamed invoices
# drive_folder_id = "<folder-id>"

# Paste the fields from the service account's JSON key file
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
